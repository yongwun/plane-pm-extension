# PM Extension Backend Configuration
# All variables are prefixed with PM_ for pydantic-settings (env_prefix)

# Database (shared with Plane)
PM_DATABASE_URL=postgresql+asyncpg://plane:plane@plane-db:5432/plane

# Plane API (internal Docker network)
PM_PLANE_BASE_URL=http://api:8000

# Plane API Token (REQUIRED)
PM_PLANE_API_TOKEN=your_api_token_here

# Plane Web UI URL
PM_PLANE_WEB_URL=http://localhost:9394

# Workspace slug (REQUIRED)
PM_PLANE_WORKSPACE_SLUG=your_workspace_slug

# Debug mode (set to false in production)
PM_DEBUG=true

# Sync interval (minutes)
PM_SYNC_INTERVAL_MINUTES=5
