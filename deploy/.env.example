# Plane PM Extension - Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================
# REQUIRED: Plane API Token
# ============================================================
# Generate at: Plane → Profile Settings → API Tokens
PM_PLANE_API_TOKEN=your_plane_api_token_here

# ============================================================
# REQUIRED: Plane Workspace Slug
# ============================================================
# Found in the URL: http://localhost:9394/{workspace_slug}/...
PM_PLANE_WORKSPACE_SLUG=your_workspace_slug

# ============================================================
# Database (defaults work with Plane Docker setup)
# ============================================================
PM_DATABASE_URL=postgresql+asyncpg://plane:plane@plane-db:5432/plane

# ============================================================
# Plane URLs
# ============================================================
PM_PLANE_BASE_URL=http://api:8000
PM_PLANE_WEB_URL=http://localhost:9394

# ============================================================
# Extension API URL (for frontend)
# ============================================================
PM_API_BASE_URL=http://localhost:8080

# ============================================================
# Docker Network
# ============================================================
# Name of Plane's Docker network (check with: docker network ls)
PLANE_NETWORK=plane-app_default
